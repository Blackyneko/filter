#!name = Sir AI 分流插件 for Loon
#!desc = 将 Apple Intelligence PCC 与 ChatGPT/视觉智能置顶分流至美区策略组。
#!openUrl = https://
#!author = BlackyNeko
#!homepage = https://
#!system = iOS 27+
#!version = 1.0.1

[General]
skip-proxy = guzzoni.apple.com
real-ip = guzzoni.apple.com, *.guzzoni.apple.com, *.siri.apple.com, dejavu.apple.com, sequoia.apple.com, *.smoot.apple.com, *.push.apple.com

[Rule]
# 1. 中文 Siri 
DOMAIN-SUFFIX, guzzoni.apple.com, DIRECT
DOMAIN-SUFFIX, siri.apple.com, DIRECT
DOMAIN, dejavu.apple.com, DIRECT
DOMAIN, sequoia.apple.com, DIRECT
DOMAIN-SUFFIX, smoot.apple.com, DIRECT

# 2. Apple Intelligence PCC 隐私云计算与区域准入
DOMAIN, gspe1-ssl.ls.apple.com, 美国自动策略
DOMAIN-SUFFIX, issuer.apple.com, 美国自动策略
DOMAIN-SUFFIX, ropes.apple.com, 美国自动策略
DOMAIN, mask-api.icloud.com, 美国自动策略
DOMAIN, mask.icloud.com, 美国自动策略
DOMAIN, mask-h2.icloud.com, 美国自动策略
DOMAIN, ss-cleanup-proxy-prod.us-east-1m.app.apple.com, 美国自动策略
DOMAIN-SUFFIX, app.apple.com, 美国自动策略
DOMAIN-SUFFIX, apple-relay.apple.com, 美国自动策略
DOMAIN-SUFFIX, apple-relay.cloudflare.com, 美国自动策略
DOMAIN-SUFFIX, apple-relay.fastly-edge.com, 美国自动策略
DOMAIN-SUFFIX, apple-relay.akamaized.net, 美国自动策略
DOMAIN-SUFFIX, cp4.cloudflare.com, 美国自动策略

# 3. Siri ChatGPT 扩展与视觉智能
DOMAIN-SUFFIX, openai.com, 美国自动策略
DOMAIN-SUFFIX, chatgpt.com, 美国自动策略
DOMAIN-SUFFIX, chat.com, 美国自动策略
DOMAIN-SUFFIX, sora.com, 美国自动策略
DOMAIN-SUFFIX, oaistatic.com, 美国自动策略
DOMAIN-SUFFIX, oaiusercontent.com, 美国自动策略
DOMAIN-SUFFIX, oaistatsig.com, 美国自动策略
DOMAIN-SUFFIX, openai.com.cdn.cloudflare.net, 美国自动策略
DOMAIN, openai-api.arkoselabs.com, 美国自动策略
DOMAIN-SUFFIX, chatgpt.livekit.cloud, 美国自动策略
DOMAIN-SUFFIX, host.livekit.cloud, 美国自动策略
DOMAIN-SUFFIX, turn.livekit.cloud, 美国自动策略
DOMAIN, lens.google.com, 美国自动策略
