#!name=Apple AI / Siri 分流
#!desc=让 Siri / Apple Intelligence / 私有中继(Relay) 走代理（Loon 可用）
#!category=Apple
# 说明：
#   1) 用法：Loon → 配置 → [Rule] 顶部引用：
#      https://raw.githubusercontent.com/Blackyneko/filter/main/Apple-AI.list,policy=PROXY,tag=Apple-AI,enabled=true
#      （把 policy=PROXY 改成你真实的策略组名）
#   2) 必须放在 GEOIP,CN / GEOSITE,cn → DIRECT 之前的靠前位置。
#   3) guzzoni.apple.com 是 Siri 命门；aaplimg.com 为整后缀，覆盖大量 *.v.aaplimg.com 子域。
# 更新：2026-11-01
#############################################

# ---- 1) Siri 主入口 ----
DOMAIN,guzzoni.apple.com
DOMAIN-SUFFIX,guzzoni-apple-com.v.aaplimg.com
DOMAIN,guzzoni.smoot.apple.com
DOMAIN-SUFFIX,guzzoni-smoot.v.aaplimg.com
DOMAIN-SUFFIX,smoot.apple.com
DOMAIN-SUFFIX,aaplimg.com
DOMAIN-KEYWORD,siri

# ---- 2) Apple Intelligence 后端 / 私有中继(Relay) / PCC ----
DOMAIN-SUFFIX,mask.apple-dns.net
DOMAIN-SUFFIX,mask-api.fe.apple-dns.net
DOMAIN-SUFFIX,mask-api.icloud.com
DOMAIN-SUFFIX,mask-t.apple-dns.net
DOMAIN-SUFFIX,mask-h2.icloud.com
DOMAIN-SUFFIX,mask.icloud.com
DOMAIN-SUFFIX,apple-relay.apple.com
DOMAIN-SUFFIX,apple-relay.cloudflare.com
DOMAIN-SUFFIX,apple-relay.fastly-edge.com
DOMAIN-SUFFIX,apple-relay.mask.apple-dns.net
DOMAIN-SUFFIX,cp4.cloudflare.com
DOMAIN-SUFFIX,gateway.icloud.com
DOMAIN-SUFFIX,gspe1-ssl.ls.apple.com
DOMAIN-SUFFIX,ls.apple.com

# ---- 3) 配套 / 媒体 ----
DOMAIN-SUFFIX,apps.mzstatic.com

# ---- 4) ChatGPT / OpenAI / 鉴权（Siri+ChatGPT 场景）----
DOMAIN-SUFFIX,chatgpt.com
DOMAIN-SUFFIX,openai.com
DOMAIN-SUFFIX,auth0.com
DOMAIN-SUFFIX,oaistatic.com
DOMAIN-SUFFIX,oaiusercontent.com
